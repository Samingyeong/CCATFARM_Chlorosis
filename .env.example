# 연구실 GPU 서버 접속 정보 템플릿
# 실제 값은 .env 에 작성한다 (.env 는 git 에 커밋되지 않음)
# 사용: cp .env.example .env  후 값 채우기

# 내부(교내망) 접속
SERVER_HOST=
SERVER_PORT=22
SERVER_USER=
SERVER_PASSWORD=

# 외부 접속 (교외망)
SERVER_EXTERNAL_HOST=
SERVER_EXTERNAL_PORT=

# 서버 경로
SERVER_ENV_HOME=~/chlorosis
SERVER_PROJECT_DIR=~/chlorosis_repo
